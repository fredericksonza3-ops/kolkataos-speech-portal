PORT=8787
PUBLIC_URL=http://localhost:8787
SPEECH_PORTAL_KEY=replace-with-a-long-random-server-key
CODE_TTL_MS=900000
SESSION_TTL_MS=3600000
# Production Vercel deployments need a shared Upstash Redis store.
# Add these from the Vercel Upstash integration; local development can leave them blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
